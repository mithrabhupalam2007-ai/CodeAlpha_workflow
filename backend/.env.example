# WorkFlow backend environment configuration template
# Copy this file to .env and fill in your values.

PORT=4000
NODE_ENV=development

# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/workflow

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Auth (JWT)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# SMTP (optional — console fallback when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WorkFlow <no-reply@workflow.local>"

# Public URL of the frontend
APP_URL=http://localhost:5173
